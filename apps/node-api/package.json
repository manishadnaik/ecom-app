{
  "name": "node-api",
  "version": "1.0.0",
  "description": "Node.js e-commerce backend API with Express.js and Sequelize ORM",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:reset": "node src/config/initDb.js",
