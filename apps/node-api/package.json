    "dotenv": "^17.4.2",
    "eslint": "^10.9.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.24.3",
    "node-cache": "^5.1.2",
    "sequelize": "^6.37.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0"
  }
